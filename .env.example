# Aucune clé secrète n'est nécessaire : tous les services utilisés sont publics.
# Copiez ce fichier en .env.local pour surcharger un service en local.
# Attention : toute variable VITE_* est intégrée au code envoyé au navigateur — n'y mettez jamais de secret.

# Données de garde (par défaut : <base>/data, produites par le collecteur)
# VITE_DATA_URL=

# Fond de carte (politique d'usage : https://operations.osmfoundation.org/policies/tiles/)
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; contributeurs OpenStreetMap

# Itinéraires OSRM (FOSSGIS) — voiture et piéton, + secours voiture
# VITE_OSRM_CAR_URL=https://routing.openstreetmap.de/routed-car
# VITE_OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
# VITE_OSRM_FALLBACK_CAR_URL=https://router.project-osrm.org

# Géocodage de l'adresse de départ (politique : https://operations.osmfoundation.org/policies/nominatim/)
# VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Utilisé seulement au build (fourni par le workflow GitHub Actions)
# BASE_PATH=/pharmacies-garde-maroc/
