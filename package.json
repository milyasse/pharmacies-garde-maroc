{
  "name": "pharmacies-garde-maroc",
  "private": true,
  "version": "1.5.0",
  "description": "Pharmacies de garde autour de soi au Maroc (Rabat, Salé, Témara) : sources datées, carte, classement par proximité et itinéraires.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "collect": "node --experimental-strip-types --no-warnings scripts/collect.ts",
    "check:sources": "node --experimental-strip-types --no-warnings scripts/collect.ts --dry-run --verbose --strict"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/leaflet": "^1.9.18",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0"
  }
}
